# Copy this file to .env and adjust values as needed.
# These defaults match the fallbacks already hardcoded in docker-compose.yml,
# so `docker compose up` works out of the box without a .env file.

NODE_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=capsule
POSTGRES_PASSWORD=capsule_dev_password
POSTGRES_DB=capsule_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://capsule:capsule_dev_password@localhost:5432/capsule_dev

# --- pgAdmin (optional, `docker compose --profile tools up -d`) ---
PGADMIN_EMAIL=admin@capsule.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Web app ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000
